# ── 필수 ─────────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
APP_PORT=8502
BASE_PATH=dogbreeder

# ── 리소스 캐시 TTL (T1-1) ───────────────────────────
# 유휴 시 모델 RAM 해제. 예: 1h, 30m, 2h30m / none·0·빈값 → 영구 상주
RESOURCE_CACHE_TTL=1h

# ── T2 기능 토글 (0=끄기 / 1=켜기, 재빌드 불필요) ────
# 하이브리드 검색(BM25+dense). 0 → dense-only
USE_HYBRID=1
# 리랭커(bge-reranker-v2-m3, 상시 RAM ~2GB). NAS RAM 부족 시 0
USE_RERANKER=1
# 범위 외(개 이외) 질문 가드. 질문당 LLM 분류 1회 추가 → 비용 민감 시 0
ENABLE_OOS_GUARD=1

# ── 검색 파라미터 ────────────────────────────────────
# 최종 LLM에 전달할 문서 수 / 재정렬 전 후보 풀 크기
RETRIEVE_K=3
FETCH_K=10
